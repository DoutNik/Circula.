# Entorno y URLs públicas (sin barra final)
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Base de datos local. En producción se usa DATABASE_URL de Neon/PostgreSQL.
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=circula
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Generar un valor largo, aleatorio y único para cada entorno.
JWTSECRET=replace-with-a-long-random-secret

# Firebase Admin: JSON completo de la cuenta de servicio en una sola línea.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# Correo transaccional
# Render Free bloquea SMTP. Usar resend y un remitente verificado allí.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=notifications@example.com
MAIL_PASS=replace-me
MAIL_FROM="Circula" <no-reply@example.com>

# Cloudinary
CLOUD_NAME=your-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Mercado Pago. En producción ACCESS_TOKEN debe comenzar por APP_USR- y el
# secreto es el Webhook signature secret del panel de Mercado Pago.
ACCESS_TOKEN=TEST-your-token-for-local-development
MP_WEBHOOK_SECRET=replace-with-webhook-signature-secret

# Lista opcional, separada por comas, de términos adicionales a moderar.
MODERATION_BLOCKED_TERMS=

# Correos con privilegios administrativos, separados por comas.
ADMIN_USERS=admin@example.com
